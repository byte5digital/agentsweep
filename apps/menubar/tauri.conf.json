{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentSweep",
  "mainBinaryName": "agentsweep-menubar",
  "identifier": "de.byte5.agentsweep",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "title": "AgentSweep",
        "url": "index.html",
        "width": 300,
        "height": 300,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "findings",
        "title": "AgentSweep",
        "url": "window.html",
        "width": 980,
        "height": 660,
        "minWidth": 760,
        "minHeight": 400,
        "visible": false,
        "center": true
      },
      {
        "label": "onboarding",
        "title": "Welcome to AgentSweep",
        "url": "onboarding.html",
        "width": 560,
        "height": 460,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "files": {
        "Library/LaunchAgents/de.byte5.agentsweep.daemon.plist": "LaunchAgents/de.byte5.agentsweep.daemon.plist"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1Mzk1OTJFMDdEQUNGNTUKUldSVno5b0hMbGs1ZGN4aHYzWmxuY29tSzdGNVg5UTFSaWNzOElvK056NjIvS1diZmFkMjg0QU8K",
      "endpoints": [
        "https://github.com/byte5digital/agentsweep/releases/latest/download/latest.json"
      ]
    }
  }
}
