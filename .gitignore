# planning working state (map, tickets); superseded by the spec
.scratch

# Rust
target/
Cargo.lock.bak

# Tauri / node
node_modules/
dist/
apps/*/src-tauri/gen/

# macOS
.DS_Store

# the developer flags read the real machine, and what they print is the author's
# own configuration; the benign corpus is public content fetched at test time.
# Neither is ever committed. Both default to target/, which is ignored above;
# these names catch a run somebody redirected by hand.
developer-report.txt
*.developer-report.txt
corpus/benign/cache/

# local secrets
.env
*.pem
*.key

# agent worktrees
.claude/worktrees/

# The menu bar app: the schemas Tauri generates on every build, and the
# sidecars build-sidecars.sh copies in. Neither is ever committed.
apps/menubar/gen/
apps/menubar/binaries/

# The Apple judgement helper built by a plain `swift build` in its package
apps/apple-judge/.build/
